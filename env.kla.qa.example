# Install as /usr/src/env/kyra-lidar-agent/.env.kla.qa on the Ubuntu host.
# This file supplies container environment variables; do not commit real passwords.
KLA_CONFIG_DIR=/usr/src/lidar-config
KLA_LOG_DIR=/var/log/iclogs/kyra-lidar-agent
KLA_LOG_LEVEL=INFO
KLA_LOG_MAX_MB=10
KLA_LOG_BACKUP_COUNT=5
KLA_WEB_HOST=0.0.0.0
KLA_WEB_PORT=8091
KLA_TRACKING_QUEUE_LIMIT=512

# Defaults used when a new LiDAR agent is created. Existing agents use lidars/<id>.json.
KLA_MQTT_HOST=mqtt.example.local
KLA_MQTT_PORT=1883
KLA_MQTT_TOPIC=Flasheye/ubuntu/tracking
KLA_MQTT_QOS=1
KLA_DEFAULT_SENSOR_ID=
KLA_DEFAULT_MAX_GAP_SEC=5
KLA_DEFAULT_MAX_JUMP_M=25

# Used when the corresponding saved LiDAR MQTT username/password is blank.
MQTT_USER=
MQTT_PASSWORD=

# Defaults for new LiDAR integrations; saved agents use lidars.json.
SUBALERT_TOPIC=subalert
RULE_CONFIGURATION_TOPIC=Rule_Configuration
RSE_CONFIGURATION_TOPIC=RSE_Configuration
LED_ON_TIME_SEC=5
