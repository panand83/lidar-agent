# Install as /usr/src/env/.env.kla.qa on the Ubuntu host.
# This file supplies container environment variables; do not commit real passwords.
KLA_CONFIG_DIR=/usr/src/lidar-config
KLA_WEB_HOST=0.0.0.0
KLA_WEB_PORT=8091

# Defaults used when a new LiDAR agent is created. Existing agents use lidars.json.
KLA_MQTT_HOST=mqtt.example.local
KLA_MQTT_PORT=1883
KLA_MQTT_TOPIC=Flasheye/ubuntu/tracking
KLA_MQTT_EVENT_TOPIC_PREFIX=Flasheye/ubuntu/lidar-events
KLA_MQTT_QOS=1
KLA_DEFAULT_SENSOR_ID=
KLA_DEFAULT_MAX_GAP_SEC=5
KLA_DEFAULT_MAX_JUMP_M=25

# Used when the corresponding saved LiDAR MQTT username/password is blank.
MQTT_USER=
MQTT_PASSWORD=
